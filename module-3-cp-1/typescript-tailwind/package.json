{
  "name": "typescript-tailwind-catalog",
  "version": "1.0.0",
  "description": "Typed interactive product catalog built with TypeScript (tsc) and Tailwind CSS.",
  "private": true,
  "scripts": {
    "build:ts": "tsc",
    "watch:ts": "tsc --watch",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "build": "npm run build:ts && npm run build:css",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
